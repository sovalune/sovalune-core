# Sovalune Server Configuration
# Copy this file to .env and fill in values

# Storage (PostgreSQL)
SOVALUNE_STORAGE_URL=postgres://sovalune:password@localhost:5432/sovalune

# NATS
SOVALUNE_NATS_URL=nats://localhost:4222

# Server
SOVALUNE_SERVER_HOST=0.0.0.0
SOVALUNE_SERVER_PORT=8090

# Model Backend
SOVALUNE_MODEL_BACKEND=openai
SOVALUNE_MODEL_API_URL=https://api.openai.com/v1
SOVALUNE_MODEL_API_KEY=sk-your-key-here
SOVALUNE_MODEL_NAME=gpt-4o
SOVALUNE_MODEL_TIMEOUT_SECS=120

# Logging
RUST_LOG=sovalune_server=info,tower_http=info

# Frontend (set in .env.local for Next.js)
# NEXT_PUBLIC_API_URL=http://localhost:8090
# NEXT_PUBLIC_WS_HOST=localhost
# NEXT_PUBLIC_WS_PORT=8090
